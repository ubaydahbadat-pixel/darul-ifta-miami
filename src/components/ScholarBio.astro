---
// A scholar's name that opens his biography when clicked (if he has one).
// heading: the name is the page's main heading (scholar page). Otherwise it is shown inline (e.g. a book's author),
// and the box also links to the scholar's page.
import type { Scholar } from '../data/madhhab';
import { md } from '../data/markdown';
interface Props { scholar: Scholar; heading?: boolean; label?: string }
const { scholar: s, heading = false, label } = Astro.props;
const text = label ?? s.short;
const html = s.bio ? await md(s.bio) : '';
const href = `/madhhab/scholars/${s.id}/`;
---
{html ? (
  <details class:list={['bio', { heading }]}>
    <summary>
      {heading ? <h1>{text}</h1> : <span class="nm">{text}</span>}
      <span class="hint">Biography<span class="chev" aria-hidden="true">▾</span></span>
    </summary>
    <div class="box">
      <div class="body" set:html={html} />
      {s.bioSource && <p class="src">Source: {s.bioSource}</p>}
      {!heading && <p class="go"><a href={href}>{s.short}: full page →</a></p>}
    </div>
  </details>
) : heading ? <h1>{text}</h1> : <a href={href}>{text}</a>}

<style>
  .bio { display: block; }
  .bio:not(.heading) { display: inline-block; vertical-align: top; max-width: 100%; }
  summary { list-style: none; cursor: pointer; display: inline-flex; align-items: baseline; flex-wrap: wrap; gap: 4px 12px; }
  summary::-webkit-details-marker { display: none; }
  .heading summary h1 { margin: 0; }
  .nm { color: var(--teal); text-decoration: underline; text-underline-offset: 3px; }
  .hint { font-family: var(--sans); font-size: .82rem; font-weight: 600; color: var(--muted); border: 1px solid var(--sand); border-radius: 999px; padding: 2px 10px; background: var(--card); white-space: nowrap; }
  .chev { display: inline-block; margin-left: 6px; transition: transform .15s; }
  details[open] .chev { transform: rotate(180deg); }
  summary:hover .hint { border-color: var(--teal); color: var(--teal); }
  .box { margin: 12px 0 4px; padding: 16px 18px; background: var(--card); border: 1px solid var(--sand); border-left: 3px solid var(--gold); border-radius: 8px; font-size: 1rem; }
  .heading .box { margin-top: 16px; }
  .body :global(p) { margin: 0 0 .8em; }
  .body :global(p:last-child) { margin-bottom: 0; }
  .src { margin: 10px 0 0; font-size: .85rem; color: var(--muted); }
  .go { margin: 8px 0 0; font-size: .92rem; }
</style>
