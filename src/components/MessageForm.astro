---
import { FORM_ACCESS_KEY } from '../data/site';
import { categories } from '../data/categories';
interface Props { kind: 'ask' | 'contact'; }
const { kind } = Astro.props;
const subject = kind === 'ask' ? 'New question — Darul Iftāʾ Miami' : 'New message — Darul Iftāʾ Miami';
---
<form action="https://api.web3forms.com/submit" method="POST" class="msg-form">
  <input type="hidden" name="access_key" value={FORM_ACCESS_KEY} />
  <input type="hidden" name="subject" value={subject} />
  <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />

  <label for="name">Name</label>
  <input id="name" name="name" autocomplete="name" />

  {kind === 'ask' ? <>
    <label for="email">Email <span class="optional">(optional)</span></label>
    <input id="email" name="email" type="email" autocomplete="email" aria-describedby="email-note" />
    <p id="email-note" class="field-note">You may ask without giving your name or email. Without an email we cannot reply to you privately: if your question is answered, the answer will appear in the <a href="/fatawa/">Fatāwā</a> without any identifying details.</p>
  </> : <>
    <label for="email">Email <span aria-hidden="true">*</span></label>
    <input id="email" name="email" type="email" required autocomplete="email" />
  </>}

  {kind === 'ask' && <>
    <label for="category">Topic</label>
    <select id="category" name="category">
      {categories.map((c) => <option>{c.name}</option>)}
      <option>Other</option>
    </select>
  </>}

  <label for="message">{kind === 'ask' ? 'Your question' : 'Message'} <span aria-hidden="true">*</span></label>
  <textarea id="message" name="message" required></textarea>

  <p style="margin-top:20px"><button class="button" type="submit">{kind === 'ask' ? 'Submit Question' : 'Send Message'}</button></p>
  {!FORM_ACCESS_KEY && <p class="setup">Form not connected yet: add the access key in <code>src/data/site.ts</code>.</p>}
</form>

<style>
  .setup { font-size: .85rem; color: #9a3412; }
  .optional { font-weight: normal; color: var(--muted); }
  .field-note { font-size: .9rem; color: var(--muted); margin: 6px 0 0; }
</style>
