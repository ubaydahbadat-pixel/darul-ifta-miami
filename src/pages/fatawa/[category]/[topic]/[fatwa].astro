---
import Base from '../../../../layouts/Base.astro';
import { categoryName } from '../../../../data/categories';
import { getFatawa, topicSlug, fatwaSlug, formatDate } from '../../../../data/fatawa';
import { md, refText } from '../../../../data/markdown';
import { WHATSAPP_CHANNEL } from '../../../../data/site';

export async function getStaticPaths() {
  const fatawa = await getFatawa();
  return fatawa.map((f) => ({
    params: { category: f.data.category, topic: topicSlug(f), fatwa: fatwaSlug(f) },
    props: { entry: f },
  }));
}

const { entry } = Astro.props;
const d = entry.data;
const catName = categoryName(d.category);

const question = await md(d.question);
const shortAnswer = await md(d.short_answer);
const explanation = await Promise.all(d.explanation.map(async (e) => ({ ...e, html: await md(e.text) })));
const hikmah = await md(d.hikmah);
const references = await Promise.all(
  d.references.map(async (r) => ({ ...r, html: await md(refText(r.text), r.language === 'Urdu' ? 'ur' : 'ar') })),
);
---
<Base title={d.title} description={`${catName} · ${d.topic}: ${d.title}`}>
  <nav class="crumbs">
    <a href="/fatawa/">Fatāwā</a><span>›</span>
    <a href={`/fatawa/${d.category}/`}>{catName}</a><span>›</span>
    <a href={`/fatawa/${d.category}/${topicSlug(entry)}/`}>{d.topic}</a>
  </nav>
  <h1>{d.title}</h1>
  <p class="meta-line">{formatDate(d.date)}</p>
  <hr class="rule" />

  <article class="fatwa">
    <h2>Question</h2>
    <Fragment set:html={question} />

    <!-- Bismillah in the Prophetic style: short bāʾ, long drawn-out sīn, then mīm. -->
    <p class="basmalah" lang="ar" dir="rtl" aria-label="Bismillāh al-Raḥmān al-Raḥīm">بِسْــــــــــمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</p>

    {shortAnswer && (
      <section class="short-answer">
        <h2>Short Answer</h2>
        <Fragment set:html={shortAnswer} />
      </section>
    )}

    {explanation.length > 0 && (
      <details class="drop">
        <summary>Explanation</summary>
        <div class="drop-body">
          {explanation.map((e, i) => (
            <><h3 class="node">{i + 1}. {e.heading}</h3><Fragment set:html={e.html} /></>
          ))}
        </div>
      </details>
    )}

    {hikmah && (
      <details class="drop">
        <summary>Wisdom of the Ruling (Ḥikmah)</summary>
        <div class="drop-body"><Fragment set:html={hikmah} /></div>
      </details>
    )}

    {references.length > 0 && (
      <details class="drop">
        <summary>References</summary>
        <div class="drop-body">
          {references.map((r, i) => (
            <>
              <h3>{i + 1}. {r.source}{r.language === 'Urdu' && <span class="lang-label">Urdu</span>}</h3>
              <Fragment set:html={r.html} />
            </>
          ))}
        </div>
      </details>
    )}

    <hr />
    <p><em>And Allah knows best.</em></p>
    <p><strong>Answered by:</strong> Mufti Ubaydah Badat</p>
  </article>

  <div class="actions">
    {d.pdf && <a class="button" href={d.pdf} download>Download PDF</a>}
    <a class="button ghost" href="/ask/">Ask a question</a>
    <a class="button ghost" href={WHATSAPP_CHANNEL} target="_blank" rel="noopener">Follow on WhatsApp</a>
  </div>
</Base>

<style>
  .meta-line { color: var(--muted); margin: 0; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 40px; padding-top: 24px; border-top: 1px solid var(--sand); }
</style>
