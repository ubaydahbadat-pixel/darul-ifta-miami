---
// Price history: the 5 am gold and silver figures, logged daily by scripts/update-nisab.mjs.
// NOT PUBLISHED: Astro skips files whose name starts with "_".
// To publish, rename this file to history.astro (the page will then be at /nisab/history/).
import Base from '../../layouts/Base.astro';
import history from '../../data/nisab-history.json';

const usd = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
const fmt = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const first = history[0];
---
<Base title="Niṣāb Price History" description="Daily 5 am gold and silver niṣāb values in US dollars.">
  <nav class="crumbs"><a href="/nisab/">Niṣāb Calculation</a><span>›</span><span>Price History</span></nav>
  <h1>Niṣāb Price History</h1>
  <hr class="rule" />
  <p class="muted">The gold and silver niṣāb at 5 am (Eastern) each day, from the spot price in US dollars. The log starts on {fmt(first.date)}.</p>

  <section class="box">
    <div class="controls">
      <div class="seg" role="group" aria-label="Metal">
        <button data-metal="gold" aria-pressed="true">Gold</button>
        <button data-metal="silver" aria-pressed="false">Silver</button>
      </div>
      <div class="seg" role="group" aria-label="Time range">
        <button data-range="7" aria-pressed="false">1W</button>
        <button data-range="31" aria-pressed="true">1M</button>
        <button data-range="183" aria-pressed="false">6M</button>
        <button data-range="366" aria-pressed="false">1Y</button>
        <button data-range="0" aria-pressed="false">All</button>
      </div>
    </div>

    <div class="stats" aria-live="polite">
      <div><span class="k">Latest niṣāb</span><span class="v" id="s-latest"></span></div>
      <div><span class="k">Change</span><span class="v" id="s-change"></span></div>
      <div><span class="k">High</span><span class="v" id="s-high"></span></div>
      <div><span class="k">Low</span><span class="v" id="s-low"></span></div>
    </div>

    <h2 class="chart-title" id="chart-title"></h2>
    <p class="muted small" id="chart-note"></p>
    <div class="chart" id="chart">
      <svg id="svg" role="img" aria-labelledby="chart-title"></svg>
      <div class="tip" id="tip" hidden></div>
    </div>
  </section>

  <details class="box table-box">
    <summary>All logged days (table)</summary>
    <table>
      <thead><tr><th>Date</th><th>Gold / oz</th><th>Gold niṣāb</th><th>Silver / oz</th><th>Silver niṣāb</th></tr></thead>
      <tbody>
        {[...history].reverse().map((h) => (
          <tr><td>{fmt(h.date)}</td><td>{usd(h.goldPerOz)}</td><td>{usd(h.goldNisab)}</td><td>{usd(h.silverPerOz)}</td><td>{usd(h.silverNisab)}</td></tr>
        ))}
      </tbody>
    </table>
  </details>

  <script type="application/json" id="data" set:html={JSON.stringify(history)}></script>
</Base>

<script>
  type Row = { date: string; goldPerOz: number; silverPerOz: number; goldNisab: number; silverNisab: number };
  const data: Row[] = JSON.parse(document.getElementById('data')!.textContent || '[]');
  const svg = document.getElementById('svg') as unknown as SVGSVGElement;
  const box = document.getElementById('chart')!;
  const tip = document.getElementById('tip')!;
  const COLORS = { gold: '#A47A10', silver: '#5B6B80' };
  const NAMES = { gold: 'Gold', silver: 'Silver' };
  let metal: 'gold' | 'silver' = 'gold';
  let range = 31;

  const usd = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD' });
  const usd0 = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
  const day = (s: string) => new Date(s + 'T12:00:00Z');
  const fmt = (s: string, long = false) => day(s).toLocaleDateString('en-US', long ? { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' } : { day: 'numeric', month: 'short', timeZone: 'UTC' });
  const NS = 'http://www.w3.org/2000/svg';
  const el = (tag: string, attrs: Record<string, string | number>, text?: string) => {
    const e = document.createElementNS(NS, tag);
    for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, String(v));
    if (text !== undefined) e.textContent = text;
    return e;
  };

  function niceTicks(min: number, max: number, count = 4) {
    if (min === max) { min -= 1; max += 1; }
    const raw = (max - min) / count;
    const mag = Math.pow(10, Math.floor(Math.log10(raw)));
    const step = [1, 2, 2.5, 5, 10].map((m) => m * mag).find((s) => s >= raw)!;
    const lo = Math.floor(min / step) * step, hi = Math.ceil(max / step) * step;
    const ticks: number[] = [];
    for (let v = lo; v <= hi + step / 2; v += step) ticks.push(Math.round(v * 100) / 100);
    return ticks;
  }

  function visible() {
    if (!range || !data.length) return data;
    const last = day(data[data.length - 1].date).getTime();
    return data.filter((r) => last - day(r.date).getTime() < range * 864e5);
  }

  function render() {
    const rows = visible();
    const key = metal === 'gold' ? 'goldNisab' : 'silverNisab';
    const perOz = metal === 'gold' ? 'goldPerOz' : 'silverPerOz';
    const vals = rows.map((r) => r[key]);
    const first = vals[0], last = vals[vals.length - 1];
    const change = last - first, pct = first ? (change / first) * 100 : 0;
    const label = (document.querySelector(`[data-range="${range}"]`) as HTMLElement).textContent;

    document.getElementById('chart-title')!.textContent = `${NAMES[metal]} niṣāb, US dollars`;
    const span = range && data.length && (day(data[data.length - 1].date).getTime() - day(data[0].date).getTime()) / 864e5 < range - 1;
    document.getElementById('chart-note')!.textContent = span
      ? `Showing all ${rows.length} logged days. The ${label} view fills in as the daily log grows.`
      : `${rows.length} days, ${fmt(rows[0].date)} – ${fmt(rows[rows.length - 1].date)}.`;
    document.getElementById('s-latest')!.textContent = usd(last);
    document.getElementById('s-change')!.innerHTML = `${change >= 0 ? '+' : '−'}${usd(Math.abs(change))} <small>${change >= 0 ? '+' : '−'}${Math.abs(pct).toFixed(1)}%</small>`;
    document.getElementById('s-high')!.textContent = usd(Math.max(...vals));
    document.getElementById('s-low')!.textContent = usd(Math.min(...vals));

    const W = box.clientWidth, H = Math.max(240, Math.min(340, W * 0.5));
    if (W < 120) return;
    const m = { t: 12, r: 14, b: 28, l: 64 };
    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
    svg.setAttribute('width', String(W)); svg.setAttribute('height', String(H));
    svg.replaceChildren();

    const ticks = niceTicks(Math.min(...vals), Math.max(...vals));
    const y0 = ticks[0], y1 = ticks[ticks.length - 1];
    const t0 = day(rows[0].date).getTime(), t1 = day(rows[rows.length - 1].date).getTime() || t0 + 1;
    const x = (s: string) => m.l + (rows.length === 1 ? (W - m.l - m.r) / 2 : ((day(s).getTime() - t0) / (t1 - t0 || 1)) * (W - m.l - m.r));
    const y = (v: number) => m.t + (1 - (v - y0) / (y1 - y0)) * (H - m.t - m.b);

    for (const t of ticks) {
      svg.append(el('line', { x1: m.l, x2: W - m.r, y1: y(t), y2: y(t), class: 'grid' }));
      svg.append(el('text', { x: m.l - 8, y: y(t) + 4, 'text-anchor': 'end', class: 'axis' }, usd0(t)));
    }
    const nX = Math.min(rows.length, Math.max(2, Math.floor((W - m.l - m.r) / 90)));
    const idx = [...new Set(Array.from({ length: nX }, (_, i) => Math.round((i * (rows.length - 1)) / Math.max(1, nX - 1))))];
    for (const i of idx) svg.append(el('text', { x: x(rows[i].date), y: H - 8, 'text-anchor': i === 0 ? 'start' : i === rows.length - 1 ? 'end' : 'middle', class: 'axis' }, fmt(rows[i].date)));

    const d = rows.map((r, i) => `${i ? 'L' : 'M'}${x(r.date).toFixed(1)},${y(r[key]).toFixed(1)}`).join('');
    svg.append(el('path', { d, fill: 'none', stroke: COLORS[metal], 'stroke-width': 2, 'stroke-linejoin': 'round', 'stroke-linecap': 'round' }));
    const lastDot = el('circle', { cx: x(rows[rows.length - 1].date), cy: y(last), r: 4, fill: COLORS[metal], stroke: '#FFFDF6', 'stroke-width': 2 });
    svg.append(lastDot);

    const cross = el('line', { y1: m.t, y2: H - m.b, class: 'cross', visibility: 'hidden' });
    const dot = el('circle', { r: 5, fill: COLORS[metal], stroke: '#FFFDF6', 'stroke-width': 2, visibility: 'hidden' });
    svg.append(cross, dot);
    const hit = el('rect', { x: m.l, y: m.t, width: W - m.l - m.r, height: H - m.t - m.b, fill: 'transparent' });
    svg.append(hit);

    const show = (clientX: number) => {
      const bx = svg.getBoundingClientRect();
      const px = clientX - bx.left;
      let best = 0;
      rows.forEach((r, i) => { if (Math.abs(x(r.date) - px) < Math.abs(x(rows[best].date) - px)) best = i; });
      const r = rows[best], cx = x(r.date), cy = y(r[key]);
      cross.setAttribute('x1', String(cx)); cross.setAttribute('x2', String(cx)); cross.setAttribute('visibility', 'visible');
      dot.setAttribute('cx', String(cx)); dot.setAttribute('cy', String(cy)); dot.setAttribute('visibility', 'visible');
      tip.innerHTML = `<strong>${fmt(r.date, true)}</strong><br>${NAMES[metal]} niṣāb: ${usd(r[key])}<br><span>${NAMES[metal]} per oz: ${usd(r[perOz])}</span>`;
      tip.hidden = false;
      const tw = tip.offsetWidth;
      tip.style.left = `${Math.min(Math.max(cx - tw / 2, 0), W - tw)}px`;
      tip.style.top = `${Math.max(cy - tip.offsetHeight - 12, 0)}px`;
    };
    const hide = () => { tip.hidden = true; cross.setAttribute('visibility', 'hidden'); dot.setAttribute('visibility', 'hidden'); };
    hit.addEventListener('pointermove', (e) => show((e as PointerEvent).clientX));
    hit.addEventListener('pointerdown', (e) => show((e as PointerEvent).clientX));
    hit.addEventListener('pointerleave', hide);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-metal]').forEach((b) => b.addEventListener('click', () => {
    metal = b.dataset.metal as 'gold' | 'silver';
    document.querySelectorAll('[data-metal]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    render();
  }));
  document.querySelectorAll<HTMLButtonElement>('[data-range]').forEach((b) => b.addEventListener('click', () => {
    range = Number(b.dataset.range);
    document.querySelectorAll('[data-range]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    render();
  }));
  window.addEventListener('resize', render);
  if (data.length) render();
</script>

<style>
  .crumbs { font-size: .9rem; color: var(--muted); display: flex; gap: 8px; margin-bottom: 8px; }
  .muted { color: var(--muted); }
  .small { font-size: .88rem; margin: 0 0 8px; }
  .box { background: var(--card); border: 1px solid var(--sand); border-radius: 12px; padding: 22px; }
  .box + .box { margin-top: 20px; }
  .controls { display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-between; margin-bottom: 16px; }
  .seg { display: inline-flex; border: 1px solid var(--sand); border-radius: 8px; overflow: hidden; background: var(--cream); }
  .seg button { font: inherit; font-size: .9rem; font-weight: 600; padding: 7px 14px; border: 0; background: none; color: var(--muted); cursor: pointer; min-height: 36px; }
  .seg button + button { border-left: 1px solid var(--sand); }
  .seg button[aria-pressed='true'] { background: var(--teal); color: #fff; }
  .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 18px; }
  @media (min-width: 620px) { .stats { grid-template-columns: repeat(4, 1fr); } }
  .stats div { border: 1px solid var(--sand); border-radius: 10px; padding: 10px 12px; background: var(--cream); }
  .k { display: block; font-size: .75rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 600; }
  .v { display: block; font-family: var(--serif); font-size: 1.25rem; font-weight: 600; color: var(--ink); }
  .v :global(small) { display: block; font-family: var(--sans); font-size: .8rem; font-weight: 600; color: var(--muted); }
  .chart-title { font-size: 1.15rem; margin: 0 0 2px; }
  .chart { position: relative; width: 100%; }
  .chart svg { display: block; width: 100%; touch-action: pan-y; }
  .chart :global(.grid) { stroke: var(--sand); stroke-width: 1; }
  .chart :global(.axis) { fill: var(--muted); font-size: 11px; font-family: var(--sans); }
  .chart :global(.cross) { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 3 3; }
  .tip { position: absolute; pointer-events: none; background: var(--ink); color: #fff; font-size: .82rem; line-height: 1.45; padding: 7px 10px; border-radius: 6px; white-space: nowrap; }
  .tip :global(span) { color: #CBD5E1; }
  .table-box summary { cursor: pointer; font-weight: 600; color: var(--teal); }
  .table-box table { width: 100%; border-collapse: collapse; margin-top: 12px; font-size: .9rem; }
  .table-box th, .table-box td { text-align: right; padding: 6px 8px; border-bottom: 1px solid var(--sand); white-space: nowrap; }
  .table-box th:first-child, .table-box td:first-child { text-align: left; }
  .table-box table { display: block; overflow-x: auto; }
</style>
