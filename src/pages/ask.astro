---
import Base from '../layouts/Base.astro';
import MessageForm from '../components/MessageForm.astro';
import askSettings from '../data/ask-settings.json';
// The turnaround is set by the Mufti in /admin → Ask Page Settings. The line is hidden while it is empty.
const turnaround = (askSettings.askTurnaround || '').trim();
---
<Base title="Ask a Question" description="Submit a question to Darul Iftāʾ Miami.">
  <h1>Ask a Question</h1>
  <hr class="rule" />
  <p class="lead">Submit your question and it will be answered according to the Ḥanafī madhhab. Selected questions may be published on the site without any identifying details.</p>
  {turnaround && <p><strong>Most questions are answered within {turnaround}.</strong></p>}
  <p>Please do not use this form for urgent matters.</p>
  <p>Before asking, you may find your answer already in the <a href="/fatawa/">Fatāwā</a>.</p>
  <MessageForm kind="ask" />
</Base>
