---
import Base from '../../layouts/Base.astro';
import { getEvents, eventDate, eventTime, lastDay, todayNY } from '../../data/events';
import { md } from '../../data/markdown';
import { WHATSAPP_CHANNEL, FORM_ACCESS_KEY } from '../../data/site';
export async function getStaticPaths() {
  const { all } = await getEvents();
  return all.map((e) => ({ params: { event: e.id }, props: { e } }));
}
const { e } = Astro.props;
const d = e.data;
const isPast = lastDay(e) < todayNY();
const descHtml = await md(d.description);
const recapHtml = await md(d.recap);
const maps = d.address ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(d.address)}` : '';
---
<Base title={`${d.title} | Events`} description={d.summary ?? `${d.title}, ${eventDate(e)}.`}>
  <nav class="crumbs"><a href="/events/">Events</a></nav>
  <p class="status" data-last-day={lastDay(e)}>{isPast ? 'Completed event' : 'Upcoming event'}</p>
  <h1>{d.title}</h1>
  <hr class="rule" />
  {d.image && <img class="poster" src={d.image} alt={`Poster for ${d.title}`} />}
  <dl class="facts">
    <dt>Date</dt><dd>{eventDate(e)}</dd>
    {eventTime(e) && <><dt>Time</dt><dd>{eventTime(e)} <span class="tz">(Miami time)</span></dd></>}
    {d.location && <><dt>Venue</dt><dd>{d.location}</dd></>}
    {d.address && <><dt>Address</dt><dd>{d.address} · <a href={maps} target="_blank" rel="noopener">Directions</a></dd></>}
  </dl>
  {d.registration_url && !isPast && <p class="register"><a class="button" href={d.registration_url} target="_blank" rel="noopener">Register</a></p>}
  {d.rsvp && !isPast && (
    <section class="rsvp" id="rsvp">
      <h2>RSVP</h2>
      <p class="note">Let us know you're coming so we can plan seating and materials.</p>
      <form action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value={FORM_ACCESS_KEY} />
        <input type="hidden" name="subject" value={`RSVP: ${d.title} (${eventDate(e)})`} />
        <input type="hidden" name="event" value={`${d.title}, ${eventDate(e)}`} />
        <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />
        <label for="r-name">Name <span aria-hidden="true">*</span></label>
        <input id="r-name" name="name" required autocomplete="name" />
        <label for="r-email">Email</label>
        <input id="r-email" name="email" type="email" autocomplete="email" />
        <label for="r-phone">Phone</label>
        <input id="r-phone" name="phone" type="tel" autocomplete="tel" />
        <label for="r-count">How many people (including you)? <span aria-hidden="true">*</span></label>
        <input id="r-count" name="attending" type="number" min="1" max="20" value="1" required />
        <p style="margin-top:18px"><button class="button" type="submit">Send RSVP</button></p>
      </form>
    </section>
  )}
  {d.materials && !isPast && (
    <section class="materials">
      <h2>Course Materials</h2>
      {d.materials_price && <p class="price">{d.materials_price}</p>}
      {d.materials_url
        ? <p><a class="button" href={d.materials_url} target="_blank" rel="noopener">Pay for course materials</a></p>
        : <p class="soon">Payment link coming soon.</p>}
    </section>
  )}
  {descHtml && <section set:html={descHtml} />}
  {isPast && recapHtml && <section class="recap"><h2>After the Event</h2><div set:html={recapHtml} /></section>}
  <p class="more"><a href="/events/">All events →</a> <span class="wa">Event announcements are also shared on our <a href={WHATSAPP_CHANNEL} target="_blank" rel="noopener">WhatsApp channel</a>.</span></p>
</Base>
<script>
  const el = document.querySelector<HTMLElement>('.status[data-last-day]');
  const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/New_York', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
  if (el && el.dataset.lastDay! < today) {
    el.textContent = 'Completed event';
    document.querySelector('.register')?.remove();
    document.querySelector('.materials')?.remove();
    document.querySelector('.rsvp')?.remove();
  }
</script>
<style>
  .status { margin: 0 0 6px; font-size: .82rem; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--teal); }
  .poster { border-radius: 10px; border: 1px solid var(--sand); margin: 0 0 24px; max-height: 520px; width: auto; }
  .facts { display: grid; grid-template-columns: max-content 1fr; gap: 6px 18px; margin: 0 0 24px; }
  .facts dt { font-weight: 600; color: var(--muted); }
  .facts dd { margin: 0; min-width: 0; }
  .tz { color: var(--muted); font-size: .9rem; }
  .register { margin: 0 0 24px; }
  section { margin: 24px 0; }
  .rsvp { padding: 18px 20px; border: 1px solid var(--sand); border-radius: 10px; scroll-margin-top: 90px; }
  .rsvp h2 { margin: 0 0 6px; font-size: 1.2rem; }
  .rsvp .note { margin: 0 0 8px; color: var(--muted); }
  .rsvp input { width: 100%; max-width: 420px; }
  .materials { padding: 18px 20px; border: 1px solid var(--sand); border-radius: 10px; }
  .materials h2 { margin: 0 0 8px; font-size: 1.2rem; }
  .materials p { margin: 0; }
  .materials .price { font-weight: 600; margin-bottom: 10px; }
  .soon { color: var(--muted); }
  .recap { padding-top: 8px; border-top: 1px solid var(--sand); }
  .more { margin-top: 32px; display: flex; flex-direction: column; gap: 6px; }
  .wa { color: var(--muted); font-size: .95rem; }
</style>
