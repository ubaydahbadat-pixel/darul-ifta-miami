---
import Base from '../layouts/Base.astro';
import FatwaList from '../components/FatwaList.astro';
import Search from '../components/Search.astro';
import { getFatawa } from '../data/fatawa';
import { categories } from '../data/categories';
import { loadMadhhab } from '../data/madhhab';
import { getCollection } from 'astro:content';
import { nisab, WHATSAPP_CHANNEL } from '../data/site';
import askSettings from '../data/ask-settings.json';
import { getEvents } from '../data/events';

// The home page. Built for the general public: the first screen holds what most visitors need
// (search, ask, today's niṣāb, the next event); everything else sits in the tabs below.
const fatawa = await getFatawa();
const latest = fatawa.slice(0, 5);
const byCategory = categories
  .map((c) => ({ ...c, count: fatawa.filter((f) => f.data.category === c.id).length }))
  .filter((c) => c.count > 0);
const { scholarList, bookList, chains } = await loadMadhhab();
const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const turnaround = (askSettings.askTurnaround || '').trim();
const { upcoming } = await getEvents();
const next = upcoming[0];
const usd = (n: number) => n.toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
const shortDate = (d: Date) => d.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' });
---
<Base>
  <!-- First screen: what most people come for -->
  <section class="hero">
    <h1>Rooted in Scholarship. Serving South Florida.</h1>
    <p class="lead">Answers to everyday questions, according to the Ḥanafī madhhab.</p>
    <Search label="Have a question? Search our answers first" />
  </section>

  <nav class="quick" aria-label="Main sections">
    <a class="tile t-emerald" href="/fatawa/">
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2z"/><path d="M4 21V5M8 7h6M8 11h6"/></svg>
      <span class="t">Browse Fatāwā</span>
      <span class="d">{fatawa.length} answers by topic</span>
    </a>
    <a class="tile t-rustic" href="/ask/">
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1.1-4.6A8 8 0 1 1 21 12z"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.3 2.4c-.5.2-.8.6-.8 1.1v.5M12 16.5v.01"/></svg>
      <span class="t">Ask a Question</span>
      <span class="d">{turnaround ? `Answered within ${turnaround}` : 'Your name is optional'}</span>
    </a>
    <a class="tile t-sage" href="/nisab/">
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 10h18M5 10v8M9.5 10v8M14.5 10v8M19 10v8M3 21h18M12 3l9 5H3z"/></svg>
      <span class="t">Zakāh &amp; Niṣāb</span>
      <span class="d">Today: {usd(nisab.goldNisab)} (gold)</span>
    </a>
    <a class="tile t-sand" href={next ? `/events/${next.id}/` : '/events/'}>
      <svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
      <span class="t">{next ? 'Next Event' : 'Events'}</span>
      <span class="d">{next ? `${shortDate(next.data.date)} · ${next.data.title.split(':')[0]}` : 'Announced here and on WhatsApp'}</span>
    </a>
  </nav>

  <!-- Everything else, grouped in tabs so nothing needs a long scroll -->
  <section class="explore" aria-label="Explore">
    <div class="tabs" role="tablist">
      <button role="tab" id="tab-topics" aria-controls="p-topics" aria-selected="true">Topics</button>
      <button role="tab" id="tab-latest" aria-controls="p-latest" aria-selected="false">Latest</button>
      <button role="tab" id="tab-learn" aria-controls="p-learn" aria-selected="false">Learn</button>
      <button role="tab" id="tab-about" aria-controls="p-about" aria-selected="false">About Us</button>
    </div>

    <div class="panel" role="tabpanel" id="p-topics" aria-labelledby="tab-topics">
      <ul class="topics">
        {byCategory.map((c) => <li><a href={`/fatawa/${c.id}/`}><span class="n">{c.name}</span><span class="c">{c.count}</span></a></li>)}
      </ul>
      <div class="layers">
        <p class="layers-h">Every answer is written in layers. Read as much as you need:</p>
        <ol>
          <li><strong>Short Answer</strong><span>the ruling, for everyone</span></li>
          <li><strong>Explanation</strong><span>the reasoning, for those who want to understand it</span></li>
          <li><strong>Wisdom (Ḥikmah)</strong><span>the wisdom behind the ruling</span></li>
          <li><strong>References</strong><span>the original texts, for students of knowledge</span></li>
        </ol>
      </div>
    </div>

    <div class="panel" role="tabpanel" id="p-latest" aria-labelledby="tab-latest">
      {latest.length ? <FatwaList items={latest} showPath /> : <p class="empty">The first fatāwā will be published soon.</p>}
      <p class="more"><a href="/fatawa/">All fatāwā →</a></p>
    </div>

    <div class="panel" role="tabpanel" id="p-learn" aria-labelledby="tab-learn">
      <div class="cols">
        <div>
          <h3><a href="/madhhab/">The Madhhab</a></h3>
          <p class="note">The scholars and books of the Ḥanafī madhhab.</p>
          <ul class="plain">
            <li><a href="/madhhab/">What is a madhhab?</a></li>
            <li><a href="/madhhab/scholars/">Scholars</a> <span>{scholarList.length}</span></li>
            <li><a href="/madhhab/books/">Books</a> <span>{bookList.length}</span></li>
            <li><a href="/madhhab/interactive/">Map and connections</a>{chains.size > 0 && <span>{chains.size} {chains.size === 1 ? 'chain' : 'chains'}</span>}</li>
          </ul>
        </div>
        <div>
          <h3><a href="/articles/">Articles</a></h3>
          {articles.length
            ? <ul class="plain">{articles.slice(0, 4).map((a) => <li><a href={`/articles/${a.id}/`}>{a.data.title}</a></li>)}</ul>
            : <p class="note">Coming soon.</p>}
          <h3><a href="/nisab/calculator/">Zakāh Tools</a></h3>
          <ul class="plain">
            <li><a href="/nisab/calculator/">Zakāh calculator and zakāh date</a></li>
            <li><a href="/nisab/#mahr">Mahr</a></li>
            <li><a href="/nisab/#fitr">Ṣadaqat al-Fiṭr</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="panel" role="tabpanel" id="p-about" aria-labelledby="tab-about">
      <p>Darul Iftāʾ Miami is a local South Florida service giving religious guidance according to the Ḥanafī madhhab. All fatāwā are answered by Mufti Ubaydah Badat.</p>
      <ul class="plain">
        <li><a href="/about/">Our purpose and the Mufti</a></li>
        <li><a href="/events/">Events</a></li>
        <li><a href="/donate/">Support Darul Iftāʾ Miami</a></li>
        <li><a href="/contact/">Contact us</a></li>
        <li><a href={WHATSAPP_CHANNEL} target="_blank" rel="noopener">WhatsApp channel</a></li>
      </ul>
    </div>
  </section>
</Base>

<script>
  // Tabs: one panel at a time. Without JavaScript every panel simply shows in turn.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.explore [role=tab]')];
  const show = (t: HTMLButtonElement) => {
    for (const x of tabs) {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
    }
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => show(t));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (d) { const n = tabs[(i + d + tabs.length) % tabs.length]; show(n); n.focus(); }
    });
  });
  document.querySelector('.explore')?.classList.add('js');
  if (tabs[0]) show(tabs[0]);
</script>

<style>
  .hero { text-align: center; padding: 18px 0 22px; }
  .hero-logo { width: min(150px, 40vw); height: auto; margin: 0 auto 8px; }
  .hero h1 { font-size: clamp(1.6rem, 4.2vw, 2.4rem); margin: 0 0 6px; }
  .hero .lead { margin: 0 0 22px; }

  /* Main sections: four equal tiles, all visible on the first screen */
  .quick { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 6px 0 34px; }
  @media (min-width: 760px) { .quick { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; } }
  .tile { display: flex; flex-direction: column; gap: 3px; padding: 16px 16px 14px; border-radius: 12px; border: 1px solid transparent; text-decoration: none; min-width: 0; transition: transform .12s, box-shadow .12s; }
  .tile:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(27, 36, 51, .16); }
  .tile svg { width: 28px; height: 28px; fill: none; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; margin-bottom: 6px; }
  .tile .t { font-family: var(--serif); font-size: 1.2rem; font-weight: 600; line-height: 1.2; }
  .tile .d { font-size: .86rem; }
  /* Four tones: emerald, rustic, sage, sand */
  .t-emerald, .t-emerald:hover { background: #0A6B47; color: #fff; }
  .t-emerald svg { stroke: #D9B65A; }
  .t-emerald .d { color: rgba(255, 255, 255, .85); }
  .t-rustic, .t-rustic:hover { background: #8E4A2F; color: #FFF7EC; }
  .t-rustic svg { stroke: #E9C27A; }
  .t-rustic .d { color: rgba(255, 247, 236, .85); }
  .t-sage, .t-sage:hover { background: #DCEBE4; border-color: #BFD8CC; color: #1B2433; }
  .t-sage svg { stroke: #0A6B47; }
  .t-sage .d { color: #4A5565; }
  .t-sand, .t-sand:hover { background: #F3E6C8; border-color: #E2CFA2; color: #1B2433; }
  .t-sand svg { stroke: #8E4A2F; }
  .t-sand .d { color: #4A5565; }

  /* Explore: tabs */
  .tabs { display: flex; gap: 4px; overflow-x: auto; border-bottom: 2px solid var(--sand); scrollbar-width: none; }
  .tabs::-webkit-scrollbar { display: none; }
  .tabs button { flex: none; background: none; border: 0; border-bottom: 3px solid transparent; margin-bottom: -2px; padding: 10px 14px; font: 600 1rem var(--sans); color: var(--muted); cursor: pointer; }
  .tabs button[aria-selected='true'] { color: var(--teal); border-bottom-color: var(--gold); }
  .explore:not(.js) .tabs { display: none; }
  .panel { padding: 20px 0 4px; }
  .explore:not(.js) .panel + .panel { border-top: 1px solid var(--sand); }

  .topics { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; }
  @media (min-width: 640px) { .topics { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .topics a { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 12px 16px; background: var(--card); border: 1px solid var(--sand); border-radius: 10px; text-decoration: none; color: var(--ink); font-weight: 600; }
  .topics a:hover { border-color: var(--teal); color: var(--teal); }
  .topics .c { flex: none; min-width: 28px; text-align: center; font-size: .82rem; color: var(--teal); background: rgba(14, 90, 85, .08); border-radius: 999px; padding: 2px 8px; }

  .layers { margin-top: 22px; padding: 16px 18px; border-left: 3px solid var(--gold); background: var(--card); border-radius: 0 10px 10px 0; }
  .layers-h { margin: 0 0 8px; font-weight: 600; }
  .layers ol { margin: 0; padding-left: 1.3em; display: grid; gap: 4px; }
  .layers li span { color: var(--muted); }
  .layers li span::before { content: ': '; }

  .cols { display: grid; gap: 8px 32px; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 640px) { .cols { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .cols h3 { margin: 0 0 4px; font-size: 1.2rem; }
  .cols h3 a { color: var(--ink); text-decoration: none; }
  .cols h3 a:hover { color: var(--teal); }
  .cols ul + h3 { margin-top: 18px; }
  .plain { list-style: none; margin: 0; padding: 0; }
  .plain li { display: flex; justify-content: space-between; gap: 10px; padding: 7px 0; border-top: 1px solid var(--sand); }
  .plain li span { color: var(--muted); font-size: .88rem; white-space: nowrap; }
  .note { margin: 0 0 8px; color: var(--muted); }
  .more { margin: 12px 0 0; }
</style>
