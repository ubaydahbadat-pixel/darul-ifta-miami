---
import Base from '../../layouts/Base.astro';
import { loadMadhhab, deathLabel } from '../../data/madhhab';

// Everything here is drawn from the Scholars, Books and Places entries in /admin.
const { places, scholarList, bookList, scholars, bookPlace, chains } = await loadMadhhab();

const data = {
  scholars: scholarList.map((s) => ({
    id: s.id, name: s.name, short: s.short, death: deathLabel(s), deathAh: s.deathAh,
    place: s.places[0] ?? null, places: s.places, students: s.students, chains: s.chains,
    bio: s.bio ? (s.bio.replace(/[*_#>]/g, '').split(/\n\s*\n/)[0].slice(0, 280) + (s.bio.length > 280 ? '…' : '')) : '',
  })),
  chains: [...chains.values()].map((c) => ({ id: c.id, name: c.name, colour: c.colour })),
  books: bookList.map((b) => {
    const a = b.author ? scholars.get(b.author)! : null;
    return { id: b.id, title: b.title, author: b.author, recensionBy: b.recensionBy, authorName: a?.short ?? '', death: a ? deathLabel(a) : '',
      place: bookPlace(b), influencedBy: b.influencedBy, type: b.type, basedOn: b.basedOn, derived: b.derived };
  }),
  places: Object.fromEntries([...places.values()].map((p) => [p.id, { name: p.name, lat: p.lat, lng: p.lng }])),
};
const empty = data.scholars.length === 0 && data.books.length === 0;
---
<Base title="Interactive | Madhhab" description="The scholars and books of the Ḥanafī madhhab on a map, and how they connect.">
  <nav class="crumbs"><a href="/madhhab/">Madhhab</a></nav>
  <h1>Interactive</h1>
  <hr class="rule" />
  {empty ? (
    <p class="empty">A map of the madhhab and historical cross-referencing will appear here once the scholars and books are compiled.</p>
  ) : (
    <>
      {data.chains.length > 0 && (
        <label class="chain-pick">Chain
          <select id="chain">
            <option value="">All chains</option>
            {data.chains.map((c) => <option value={c.id}>{c.name}</option>)}
          </select>
        </label>
      )}
      <div class="tabs" role="tablist">
        <button role="tab" id="tab-map" aria-selected="true" aria-controls="panel-map">Map</button>
        <button role="tab" id="tab-net" aria-selected="false" aria-controls="panel-net">Connections</button>
      </div>

      <section id="panel-map" role="tabpanel" aria-labelledby="tab-map">
        <p class="hint">Where the scholars lived and where the books are from. Tap a place to see who and what is there.</p>
        <label class="toggle"><input type="checkbox" id="show-lines" checked /> Show teacher–student lines</label>
        <div id="map" class="canvas"></div>
      </section>

      <section id="panel-net" role="tabpanel" aria-labelledby="tab-net" hidden>
        <p class="hint">How the scholars and books connect. Drag to move, pinch or scroll to zoom, tap a name or book for details.</p>
        <div class="controls">
          <label class="toggle"><input type="checkbox" id="show-scholars" checked /> Scholars</label>
          <label class="toggle"><input type="checkbox" id="show-books" checked /> Books</label>
          <label class="toggle"><input type="checkbox" id="show-unlinked" /> Scholars with no links yet <span class="count-unlinked"></span></label>
        </div>
        <div id="net" class="canvas"></div>
        <ul class="legend">
          <li><span class="dot scholar"></span>Scholar</li>
          <li><span class="dot book"></span>Book</li>
          <li><span class="line teach"></span>Teacher → student</li>
          <li><span class="line wrote"></span>Author → book</li>
          <li><span class="line rec"></span>Recension → book</li>
          <li><span class="line based"></span>Book → commentary, abridgement or gloss</li>
          <li><span class="line infl"></span>Book → book it influenced</li>
        </ul>
        <div id="detail" class="detail" hidden></div>
      </section>

      <script type="application/json" id="madhhab-data" set:html={JSON.stringify(data)} />
    </>
  )}
</Base>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import { Network, DataSet } from 'vis-network/standalone';

  const el = document.getElementById('madhhab-data');
  if (el) {
    type D = {
      scholars: { id: string; name: string; short: string; death: string; deathAh: number | null; place: string | null; places: string[]; students: string[]; chains: string[]; bio: string }[];
      chains: { id: string; name: string; colour: string }[];
      books: { id: string; title: string; author: string | null; recensionBy: string[]; authorName: string; death: string; place: string | null; influencedBy: string[]; type: string | null; basedOn: string[]; derived: string[] }[];
      places: Record<string, { name: string; lat: number; lng: number }>;
    };
    const d: D = JSON.parse(el.textContent!);
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const TEAL = '#0F766E', GOLD = '#D4A329', MUTED = '#64748B';
    // Chains: each scholar takes the colour of his first chain; the menu shows one chain at a time.
    const chainById = new Map(d.chains.map((c) => [c.id, c]));
    const colourOf = (s: D['scholars'][number]) => (s.chains[0] && chainById.get(s.chains[0])?.colour) || TEAL;
    const chainSel = document.getElementById('chain') as HTMLSelectElement | null;
    const qChain = new URLSearchParams(location.search).get('chain');
    if (chainSel && qChain && chainById.has(qChain)) chainSel.value = qChain;
    const current = () => chainSel?.value || '';
    const inChain = (s: D['scholars'][number], c = current()) => !c || s.chains.includes(c);

    // ── Tabs ──
    const tabs = [['tab-map', 'panel-map'], ['tab-net', 'panel-net']] as const;
    let netStarted = false;
    function show(which: number) {
      tabs.forEach(([t, p], i) => {
        document.getElementById(t)!.setAttribute('aria-selected', String(i === which));
        document.getElementById(p)!.hidden = i !== which;
      });
      if (which === 0) map.invalidateSize();
      if (which === 1 && !netStarted) { netStarted = true; startNetwork(); }
    }
    tabs.forEach(([t], i) => document.getElementById(t)!.addEventListener('click', () => show(i)));

    // ── Geographic map ──
    const map = L.map('map', { scrollWheelZoom: false, worldCopyJump: true });
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 12, attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);

    const markers = L.layerGroup().addTo(map);
    const lines = L.layerGroup();
    const sById = new Map(d.scholars.map((s) => [s.id, s]));
    const showLines = document.getElementById('show-lines') as HTMLInputElement;
    function drawMap(fit: boolean) {
      markers.clearLayers(); lines.clearLayers();
      const c = current();
      const scholarsHere = d.scholars.filter((s) => inChain(s));
      const ids = new Set(scholarsHere.map((s) => s.id));
      const booksHere = d.books.filter((b) => !c || (b.author && ids.has(b.author)));
      const byPlace = new Map<string, { scholars: D['scholars']; books: D['books'] }>();
      const at = (p: string) => { if (!byPlace.has(p)) byPlace.set(p, { scholars: [], books: [] }); return byPlace.get(p)!; };
      scholarsHere.forEach((s) => s.places.forEach((p) => d.places[p] && at(p).scholars.push(s)));
      booksHere.forEach((b) => b.place && d.places[b.place] && at(b.place).books.push(b));

      const bounds: [number, number][] = [];
      const colour = c ? chainById.get(c)!.colour : TEAL;
      byPlace.forEach((v, id) => {
        const p = d.places[id];
        bounds.push([p.lat, p.lng]);
        const n = v.scholars.length + v.books.length;
        const html = `<strong>${esc(p.name)}</strong>` +
          (v.scholars.length ? `<p class="pop-h">Scholars</p><ul>${v.scholars.map((s) => `<li><a href="/madhhab/scholars/${s.id}/">${esc(s.short)}</a>${s.death ? ` <span>${esc(s.death)}</span>` : ''}</li>`).join('')}</ul>` : '') +
          (v.books.length ? `<p class="pop-h">Books</p><ul>${v.books.map((b) => `<li><a href="/madhhab/books/${b.id}/">${esc(b.title)}</a></li>`).join('')}</ul>` : '');
        L.circleMarker([p.lat, p.lng], { radius: 6 + Math.min(n, 10), color: colour, weight: 2, fillColor: colour, fillOpacity: 0.35 })
          .bindPopup(html, { maxWidth: 260 }).bindTooltip(p.name).addTo(markers);
      });
      // Teacher–student lines between each pair's main places.
      scholarsHere.forEach((t) => t.students.forEach((sid) => {
        const s = sById.get(sid);
        if (!s || !ids.has(sid) || !t.place || !s.place || t.place === s.place) return;
        const a = d.places[t.place], b = d.places[s.place];
        L.polyline([[a.lat, a.lng], [b.lat, b.lng]], { color: c ? colour : GOLD, weight: 2, opacity: 0.8, dashArray: '4 6' })
          .bindTooltip(`${t.short} → ${s.short}`).addTo(lines);
      }));
      if (showLines.checked) lines.addTo(map);
      if (!fit) return;
      if (bounds.length > 1) map.fitBounds(bounds, { padding: [30, 30], maxZoom: 6 });
      else if (bounds.length === 1) map.setView(bounds[0], 5);
      else map.setView([32, 50], 3);
    }
    drawMap(true);
    showLines.addEventListener('change', () => (showLines.checked ? lines.addTo(map) : lines.remove()));
    let applyNetChain: (() => void) | null = null;
    chainSel?.addEventListener('change', () => {
      drawMap(true);
      applyNetChain?.();
      const u = new URL(location.href);
      if (current()) u.searchParams.set('chain', current()); else u.searchParams.delete('chain');
      history.replaceState(null, '', u);
    });

    // ── Connections network ──
    function startNetwork() {
      // Fixed layout by generation: each student sits at least one row below every teacher
      // (earliest generation at the top), and each book sits just below its author.
      // Scholars with no teacher or student links yet go on the bottom row.
      const sById2 = new Map(d.scholars.map((s) => [s.id, s]));
      const teachersOf = new Map<string, string[]>(d.scholars.map((s) => [s.id, []]));
      d.scholars.forEach((t) => t.students.forEach((st) => teachersOf.get(st)?.push(t.id)));
      const gen = new Map<string, number>();
      const genOf = (id: string, seen = new Set<string>()): number => {
        if (gen.has(id)) return gen.get(id)!;
        if (seen.has(id)) return 0; seen.add(id);
        const g = Math.max(-1, ...teachersOf.get(id)!.map((t) => genOf(t, seen))) + 1;
        gen.set(id, g); return g;
      };
      const linked = (s: D['scholars'][number]) => s.students.length > 0 || teachersOf.get(s.id)!.length > 0
        || d.books.some((b) => b.author === s.id || b.recensionBy.includes(s.id));
      d.scholars.forEach((s) => genOf(s.id));
      // A scholar with students but no teachers entered yet (e.g. Imām Mālik) is placed by date of death:
      // on the row of the latest linked scholar who died before him, but still above his own students.
      d.scholars.forEach((s) => {
        if (teachersOf.get(s.id)!.length || s.deathAh == null || !s.students.length) return;
        const earlier = d.scholars.filter((x) => x.id !== s.id && teachersOf.get(x.id)!.length && x.deathAh != null && x.deathAh < s.deathAh!);
        const byDate = Math.max(0, ...earlier.map((x) => gen.get(x.id)!));
        const cap = Math.min(...s.students.map((x) => gen.get(x) ?? Infinity)) - 1;
        gen.set(s.id, Math.max(0, Math.min(byDate, cap)));
      });
      const maxGen = Math.max(0, ...d.scholars.filter(linked).map((s) => gen.get(s.id)!));
      const rowOfScholar = (s: D['scholars'][number]) => (linked(s) ? gen.get(s.id)! * 2 : (maxGen + 1) * 2);
      // A book with many works written on it (e.g. 25 commentaries) would crowd the map, so when a book has
      // more than COLLAPSE works of one type, those that have no other links are shown as one box
      // ("Commentaries (25)") that opens the list on the base book's page.
      const COLLAPSE = 6;
      const bById = new Map(d.books.map((b) => [b.id, b]));
      const hasOtherLinks = (b: D['books'][number]) => b.derived.length > 0 || b.influencedBy.length > 0 || b.recensionBy.length > 0
        || d.books.some((x) => x.influencedBy.includes(b.id));
      const collapsed = new Set<string>();
      const summaries: { id: string; base: string; type: string; count: number }[] = [];
      d.books.forEach((base) => {
        const byType = new Map<string, string[]>();
        base.derived.forEach((x) => { const t = bById.get(x)!.type ?? 'Other'; byType.set(t, [...(byType.get(t) ?? []), x]); });
        byType.forEach((ids, type) => {
          const leaves = ids.filter((x) => !hasOtherLinks(bById.get(x)!));
          if (ids.length <= COLLAPSE || leaves.length < 2) return;
          leaves.forEach((x) => collapsed.add(x));
          summaries.push({ id: `g:${base.id}:${type}`, base: base.id, type, count: leaves.length });
        });
      });
      const bookLevel = (b: D['books'][number]): number => {
        const based = b.basedOn.some((x) => bById.has(x));
        // A book with no author entered sits just under the book it is based on (or on the bottom row).
        const own = b.author && sById2.get(b.author) ? rowOfScholar(sById2.get(b.author)!) + 1 : based ? 0 : (maxGen + 1) * 2 + 1;
        const below = b.basedOn.filter((x) => bById.has(x)).map((x) => bookLevel(bById.get(x)!) + 1);
        return Math.max(own, ...below);
      };
      const plural = (t: string) => ({ 'Commentary (Sharḥ)': 'Commentaries', 'Abridgement (Mukhtaṣar)': 'Abridgements', 'Gloss (Ḥāshiyah)': 'Glosses' } as Record<string, string>)[t] ?? 'Works';
      const allNodes: any[] = ([
        ...d.scholars.map((s) => ({ id: 's:' + s.id, label: s.short + (s.death ? `\n${s.death}` : ''), group: s.chains[0] && chainById.has(s.chains[0]) ? 'chain:' + s.chains[0] : 'scholar', kind: 's', ref: s, level: rowOfScholar(s) })),
        ...d.books.filter((b) => !collapsed.has(b.id)).map((b) => ({ id: 'b:' + b.id, label: wrap(b.title), group: 'book', kind: 'b', ref: b, level: bookLevel(b) })),
        ...summaries.map((g) => ({ id: g.id, label: `${plural(g.type)} (${g.count})`, group: 'summary', kind: 'g', ref: g, level: bookLevel(bById.get(g.base)!) + 1 })),
      ]);
      const nodeById = new Map(allNodes.map((n) => [n.id, n]));
      const allEdges: any[] = ([
        ...d.scholars.flatMap((t) => t.students.map((s) => ({ from: 's:' + t.id, to: 's:' + s, color: { color: TEAL }, kind: 'teach' }))),
        ...d.books.filter((b) => b.author && !collapsed.has(b.id)).map((b) => ({ from: 's:' + b.author, to: 'b:' + b.id, dashes: true, color: { color: MUTED }, kind: 'wrote' })),
        ...d.books.flatMap((b) => b.recensionBy.map((x) => ({ from: 's:' + x, to: 'b:' + b.id, dashes: [2, 4], color: { color: '#7C3AED' }, kind: 'rec' }))),
        ...d.books.flatMap((b) => b.influencedBy.map((x) => ({ from: 'b:' + x, to: 'b:' + b.id, color: { color: GOLD }, kind: 'infl' }))),
        ...d.books.filter((b) => !collapsed.has(b.id)).flatMap((b) => b.basedOn.map((x) => ({ from: 'b:' + x, to: 'b:' + b.id, width: 2.5, color: { color: '#B45309' }, kind: 'based' }))),
        ...summaries.map((g) => ({ from: 'b:' + g.base, to: g.id, width: 2.5, color: { color: '#B45309' }, kind: 'based' })),
      ].map((e, i) => ({ id: i, arrows: 'to', width: 1.5, ...e })));

      // Each chain gets its own style group (same shape as a scholar, in the chain's colour).
      const scholarStyle = (bg: string, border: string) => ({ shape: 'box', margin: 8, shapeProperties: { borderRadius: 14 },
        color: { background: bg, border, highlight: { background: bg, border: '#0F172A' }, hover: { background: bg, border: '#0F172A' } },
        font: { size: 14, face: 'Source Sans 3, system-ui', color: '#FFFFFF', multi: false } });
      const chainGroups = Object.fromEntries(d.chains.map((c) => ['chain:' + c.id, scholarStyle(c.colour, c.colour)]));
      const net = new Network(document.getElementById('net')!, { nodes: new DataSet<any>([]), edges: new DataSet<any>([]) }, {
        groups: {
          ...chainGroups,
          scholar: { shape: 'box', margin: 8, shapeProperties: { borderRadius: 14 }, color: { background: TEAL, border: '#0B5A54', highlight: { background: '#14A396', border: '#0B5A54' }, hover: { background: '#14A396', border: '#0B5A54' } }, font: { size: 14, face: 'Source Sans 3, system-ui', color: '#FFFFFF', multi: false } },
          summary: { shape: 'box', margin: 8, borderWidth: 2, shapeProperties: { borderDashes: [4, 3] }, color: { background: '#FFF7E6', border: '#B45309', highlight: { background: '#FDE7C0', border: '#B45309' } }, font: { size: 13, face: 'Source Sans 3, system-ui', color: '#7C2D12' } },
          book: { shape: 'box', margin: 8, color: { background: '#FBEFC9', border: GOLD, highlight: { background: '#F6DE91', border: GOLD } }, font: { size: 13, face: 'Source Sans 3, system-ui', color: '#0F172A' } },
        },
        edges: { smooth: { enabled: true, type: 'cubicBezier', forceDirection: 'vertical', roundness: 0.4 }, arrows: { to: { scaleFactor: 0.6 } } },
        layout: { hierarchical: { enabled: true, direction: 'UD', levelSeparation: 70, nodeSpacing: 150, treeSpacing: 150, blockShifting: true, edgeMinimization: true, parentCentralization: true } },
        physics: false,
        interaction: { hover: true, tooltipDelay: 150 },
      });

      const detail = document.getElementById('detail')!;
      function select(id: string | undefined) {
        if (!id) { detail.hidden = true; return; }
        const n: any = nodeById.get(id);
        if (!n) return;
        detail.hidden = false;
        if (n.kind === 'g') {
          const base = bById.get(n.ref.base)!;
          detail.innerHTML = `<strong>${esc(plural(n.ref.type))} on ${esc(base.title)}</strong><span>${n.ref.count} works</span><a class="button" href="/madhhab/books/${base.id}/#${esc(n.ref.type.replace(/\s*\(.*\)$/, '').toLowerCase())}">See the list</a>`;
          return;
        }
        detail.innerHTML = n.kind === 's'
          ? `<strong>${esc(n.ref.short)}</strong>${n.ref.death ? `<span>${esc(n.ref.death)}</span>` : ''}<a class="button" href="/madhhab/scholars/${n.ref.id}/">Open scholar</a>${n.ref.bio ? `<p class="bio">${esc(n.ref.bio)}</p>` : ''}`
          : `<strong>${esc(n.ref.title)}</strong>${n.ref.authorName ? `<span>${esc(n.ref.authorName)}${n.ref.death ? ' · ' + esc(n.ref.death) : ''}</span>` : ''}<a class="button" href="/madhhab/books/${n.ref.id}/">Open book</a>`;
      }
      net.on('click', (p: any) => select(p.nodes[0]));

      // What is drawn: scholars and/or books, one chain or all, and (only when asked for) scholars with no
      // links yet. The network is redrawn each time so the layout closes up around what is shown.
      const unlinkedBox = document.getElementById('show-unlinked') as HTMLInputElement;
      const unlinkedCount = d.scholars.filter((s) => !linked(s)).length;
      document.querySelector('.count-unlinked')!.textContent = unlinkedCount ? `(${unlinkedCount})` : '';
      if (!unlinkedCount) unlinkedBox.closest('label')!.hidden = true;
      const filter = () => {
        const sOn = (document.getElementById('show-scholars') as HTMLInputElement).checked;
        const bOn = (document.getElementById('show-books') as HTMLInputElement).checked;
        const c = current();
        const ids = new Set(d.scholars.filter((s) => inChain(s, c) && (unlinkedBox.checked || linked(s))).map((s) => s.id));
        const bookIn = (b: D['books'][number]): boolean => !c || (!!b.author && ids.has(b.author)) || b.recensionBy.some((x) => ids.has(x));
        const shown = allNodes.filter((n) => n.kind === 's' ? sOn && ids.has(n.ref.id)
          : n.kind === 'b' ? bOn && bookIn(n.ref) : bOn && bookIn(bById.get(n.ref.base)!));
        const on = new Set(shown.map((n) => n.id));
        net.setData({ nodes: new DataSet<any>(shown), edges: new DataSet<any>(allEdges.filter((e) => on.has(e.from) && on.has(e.to))) });
        detail.hidden = true;
      };
      applyNetChain = filter;
      ['show-scholars', 'show-books', 'show-unlinked'].forEach((id) => document.getElementById(id)!.addEventListener('change', filter));

      // ?focus=s:<id> or b:<id> opens straight onto that scholar or book.
      const focus = new URLSearchParams(location.search).get('focus');
      const fn = focus ? nodeById.get(focus) : null;
      if (fn?.kind === 's' && !linked(fn.ref)) unlinkedBox.checked = true;
      filter();
      if (focus && fn) {
        setTimeout(() => { net.selectNodes([focus]); net.focus(focus, { scale: 1.2, animation: true }); select(focus); }, 50);
      }
    }
    function wrap(t: string) {
      const words = t.split(' '); const out: string[] = []; let line = '';
      words.forEach((w) => { if ((line + ' ' + w).trim().length > 22 && line) { out.push(line); line = w; } else line = (line + ' ' + w).trim(); });
      out.push(line); return out.join('\n');
    }

    if (new URLSearchParams(location.search).get('focus')) show(1);
  }
</script>

<style>
  .chain-pick { display: flex; align-items: center; gap: 10px; font-weight: 600; margin: 0 0 14px; }
  .chain-pick select { width: auto; margin: 0; }
  .tabs { display: flex; gap: 6px; border-bottom: 1px solid var(--sand); margin-bottom: 16px; }
  .tabs button { font: inherit; font-weight: 600; background: none; border: 0; border-bottom: 3px solid transparent; padding: 10px 14px; cursor: pointer; color: var(--muted); }
  .tabs button[aria-selected='true'] { color: var(--teal); border-bottom-color: var(--gold); }
  .hint { color: var(--muted); font-size: .95rem; margin: 0 0 10px; }
  .controls { display: flex; gap: 18px; flex-wrap: wrap; }
  .tabs + section .toggle, .controls .toggle { width: auto; }
  label.toggle { display: inline-flex; width: auto; font-weight: 600; margin-top: 0; align-items: center; gap: 6px; font-size: .95rem; margin-bottom: 10px; cursor: pointer; }
  .toggle input { width: auto; margin: 0; padding: 0; }
  .canvas { height: min(80vh, 720px); border: 1px solid var(--sand); border-radius: 10px; background: var(--card); overflow: hidden; }
  .legend { list-style: none; padding: 0; margin: 12px 0 0; display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: .88rem; color: var(--muted); }
  .legend li { display: inline-flex; align-items: center; gap: 6px; }
  .dot { width: 12px; height: 12px; display: inline-block; }
  .dot.scholar { background: #0F766E; border-radius: 6px; width: 16px; }
  .dot.book { background: #FBEFC9; border: 1px solid #D4A329; border-radius: 2px; }
  .line { width: 22px; height: 0; display: inline-block; border-top: 2px solid; }
  .line.teach { border-color: #0F766E; }
  .line.wrote { border-color: #64748B; border-top-style: dashed; }
  .line.rec { border-color: #7C3AED; border-top-style: dotted; }
