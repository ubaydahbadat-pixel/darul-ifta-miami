---
import Base from '../../../layouts/Base.astro';
import { loadMadhhab, deathLabel } from '../../../data/madhhab';
export async function getStaticPaths() {
  const { scholarList } = await loadMadhhab();
  return scholarList.map((s) => ({ params: { scholar: s.id } }));
}
const { scholars, books, places } = await loadMadhhab();
const s = scholars.get(Astro.params.scholar!)!;
const link = (id: string) => scholars.get(id)!;
const rows = [
  { label: 'Teachers', items: s.teachers.map((id) => ({ href: `/madhhab/scholars/${id}/`, text: link(id).name, meta: deathLabel(link(id)) })) },
  { label: 'Students', items: s.students.map((id) => ({ href: `/madhhab/scholars/${id}/`, text: link(id).name, meta: deathLabel(link(id)) })) },
  { label: 'Books written', items: s.books.map((id) => ({ href: `/madhhab/books/${id}/`, text: books.get(id)!.title, meta: '' })) },
  { label: 'Recensions transmitted', items: s.recensions.map((id) => { const x = books.get(id)!; const a = x.author ? scholars.get(x.author)! : null; return { href: `/madhhab/books/${id}/`, text: x.title, meta: a ? a.short : '' }; }) },
];
---
<Base title={`${s.short} | Scholars`}>
  <nav class="crumbs"><a href="/madhhab/">Madhhab</a><span>›</span><a href="/madhhab/scholars/">Scholars</a></nav>
  <h1>{s.name}</h1>
  <hr class="rule" />
  <dl class="facts">
    {deathLabel(s) && <><dt>Death</dt><dd>{deathLabel(s).replace('d. ', '').replace('c. ', 'c. ')}{s.approx && ' (approximate)'}</dd></>}
    {s.places.length > 0 && <><dt>Location</dt><dd>{s.places.map((p) => places.get(p)!.name).join(', ')}</dd></>}
  </dl>
  {rows.map((r) => r.items.length > 0 && (
    <section>
      <h2>{r.label}</h2>
      <ul class="cards">{r.items.map((i) => <li><a href={i.href}><span class="name">{i.text}</span>{i.meta && <span class="meta">{i.meta}</span>}</a></li>)}</ul>
    </section>
  ))}
  <p class="more"><a href={`/madhhab/interactive/?focus=s:${s.id}`}>See on the connections map →</a></p>
</Base>
<style>
  .facts { display: grid; grid-template-columns: max-content 1fr; gap: 6px 18px; margin: 0 0 28px; }
  .facts dt { font-weight: 600; color: var(--muted); }
  .facts dd { margin: 0; }
  section { margin: 28px 0; }
  .more { margin-top: 28px; }
</style>
