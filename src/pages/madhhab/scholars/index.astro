---
import Base from '../../../layouts/Base.astro';
import { loadMadhhab, deathLabel } from '../../../data/madhhab';
const { scholarList, places } = await loadMadhhab();
// Rasūlullāh ﷺ has his own hand-written page; the rest come from the Scholars form in /admin, by date of death.
const scholars = [
  { href: '/madhhab/scholars/rasulullah/', name: 'Rasūlullāh ﷺ', meta: 'The source of the madhhab · d. 11 AH, Madīnah' },
  ...scholarList.map((s) => ({
    href: `/madhhab/scholars/${s.id}/`, name: s.name,
    meta: [deathLabel(s), s.places.map((p) => places.get(p)!.name).join(', ')].filter(Boolean).join(' · '),
  })),
];
---
<Base title="Scholars | Madhhab">
  <nav class="crumbs"><a href="/madhhab/">Madhhab</a></nav>
  <h1>Scholars</h1>
  <hr class="rule" />
  <p class="lead">The chain of the Ḥanafī madhhab, from its source to the scholars who carried it.</p>
  <ul class="cards">
    {scholars.map((s) => <li><a href={s.href}><span class="name">{s.name}</span>{s.meta && <span class="meta">{s.meta}</span>}</a></li>)}
  </ul>
  <p class="more"><a href="/madhhab/interactive/">See the scholars on the map and how they connect →</a></p>
</Base>
<style>.more { margin-top: 24px; }</style>
