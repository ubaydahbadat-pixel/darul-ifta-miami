---
import Base from '../../../layouts/Base.astro';
import { loadMadhhab, deathLabel, TABAQAT } from '../../../data/madhhab';
const { scholarList, places } = await loadMadhhab();
// Rasūlullāh ﷺ stands on his own. Everyone else is grouped by the Ṭabaqah field in /admin
// (Ṣaḥābah, Tābiʿūn, Ṭabaqah 1, 2, …), and by date of death within each group.
const card = (s: (typeof scholarList)[number]) => ({
  href: `/madhhab/scholars/${s.id}/`, name: s.name,
  meta: [deathLabel(s), s.places.map((p) => places.get(p)!.name).join(', ')].filter(Boolean).join(' · '),
});
const groups = [
  ...TABAQAT.map((t) => ({ name: t, items: scholarList.filter((s) => s.tabaqah === t).map(card) })),
  { name: 'Not yet placed', items: scholarList.filter((s) => !s.tabaqah || !TABAQAT.includes(s.tabaqah)).map(card) },
].filter((g) => g.items.length > 0);
const anchor = (n: string) => n.normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[ʿʾ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-');
---
<Base title="Scholars | Madhhab">
  <nav class="crumbs"><a href="/madhhab/">Madhhab</a></nav>
  <h1>Scholars</h1>
  <hr class="rule" />
  <p class="lead">The chain of the Ḥanafī madhhab, from its source to the scholars who carried it.</p>

  <ul class="cards source">
    <li><a href="/madhhab/scholars/rasulullah/"><span class="name">Rasūlullāh ﷺ</span><span class="meta">The source of the madhhab · d. 11 AH, Madīnah</span></a></li>
  </ul>

  {groups.length > 1 && (
    <nav class="jump" aria-label="Groups">
      {groups.map((g) => <a href={`#${anchor(g.name)}`}>{g.name}</a>)}
    </nav>
  )}

  {groups.map((g) => (
    <section id={anchor(g.name)}>
      <h2>{g.name}</h2>
      <ul class="cards">
        {g.items.map((s) => <li><a href={s.href}><span class="name">{s.name}</span>{s.meta && <span class="meta">{s.meta}</span>}</a></li>)}
      </ul>
    </section>
  ))}

  <p class="more"><a href="/madhhab/interactive/">See the scholars on the map and how they connect →</a></p>
</Base>
<style>
  .source a { border-color: var(--gold); }
  .jump { display: flex; flex-wrap: wrap; gap: 8px; margin: 28px 0 8px; }
  .jump a { font-size: .92rem; font-weight: 600; text-decoration: none; padding: 6px 12px; border: 1px solid var(--sand); border-radius: 999px; background: var(--card); }
  .jump a:hover { border-color: var(--teal); }
  section { margin-top: 32px; scroll-margin-top: 16px; }
  .more { margin-top: 28px; }
</style>
