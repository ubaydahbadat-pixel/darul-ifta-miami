---
import Base from '../../../layouts/Base.astro';

// Each āyah: Arabic, translation, reference.
const groups = [
  {
    title: 'His Mission',
    ayat: [
      { ar: 'وَمَا أَرْسَلْنَاكَ إِلَّا رَحْمَةً لِّلْعَالَمِينَ', en: 'And We have not sent you except as a mercy to all the worlds.', ref: 'al-Anbiyāʾ 21:107' },
      { ar: 'يَا أَيُّهَا النَّبِيُّ إِنَّا أَرْسَلْنَاكَ شَاهِدًا وَمُبَشِّرًا وَنَذِيرًا', en: 'O Prophet, indeed We have sent you as a witness, a bearer of good news and a warner.', ref: 'al-Aḥzāb 33:45' },
      { ar: 'لَقَدْ مَنَّ اللَّهُ عَلَى الْمُؤْمِنِينَ إِذْ بَعَثَ فِيهِمْ رَسُولًا مِّنْ أَنفُسِهِمْ', en: 'Allah has certainly conferred a favour upon the believers when He sent among them a Messenger from among themselves.', ref: 'Āl ʿImrān 3:164' },
    ],
  },
  {
    title: 'His Commands',
    ayat: [
      { ar: 'يَا أَيُّهَا الرَّسُولُ بَلِّغْ مَا أُنزِلَ إِلَيْكَ مِن رَّبِّكَ', en: 'O Messenger, convey what has been sent down to you from your Lord.', ref: 'al-Māʾidah 5:67' },
      { ar: 'يَا أَيُّهَا النَّبِيُّ جَاهِدِ الْكُفَّارَ وَالْمُنَافِقِينَ', en: 'O Prophet, strive against the disbelievers and the hypocrites.', ref: 'al-Tawbah 9:73' },
      { ar: 'يَا أَيُّهَا الْمُدَّثِّرُ ﴿١﴾ قُمْ فَأَنذِرْ ﴿٢﴾', en: 'O you wrapped in your cloak, arise and warn.', ref: 'al-Muddaththir 74:1–2' },
    ],
  },
];
---
<Base title="Rasūlullāh ﷺ | Scholars" description="Rasūlullāh ﷺ, the source of the madhhab.">
  <nav class="crumbs"><a href="/madhhab/">Madhhab</a><span>›</span><a href="/madhhab/scholars/">Scholars</a></nav>
  <h1>Rasūlullāh ﷺ</h1>
  <p class="sub">The Source of the Madhhab</p>
  <hr class="rule" />

  <p class="lead">Every madhhab begins with Rasūlullāh ﷺ. He is the origin (<em>al-manshaʾ</em>) and the primary source: the Ṣaḥābah took the religion from him, and every scholar of the madhhab after them inherits from that same source.</p>

  <section class="key">
    <p class="label">The foundation</p>
    <p class="ar big">مَّن يُطِعِ الرَّسُولَ فَقَدْ أَطَاعَ اللَّهَ</p>
    <p class="en">“Whoever obeys the Messenger has obeyed Allah.”</p>
    <p class="ref">al-Nisāʾ 4:80</p>
    <!-- Draft framing: edit or replace with your own explanation. -->
    <p class="why">Obedience to Rasūlullāh ﷺ is obedience to Allah. The madhhab exists to preserve and convey that obedience: how the Ṣaḥābah understood and practised what he taught, passed down through a chain of scholars.</p>
  </section>

  <h2>Rasūlullāh ﷺ in the Qurʾān</h2>
  {groups.map((g) => (
    <>
      <h3>{g.title}</h3>
      <ul class="ayat">
        {g.ayat.map((a) => (
          <li>
            <p class="ar">{a.ar}</p>
            <p class="en">“{a.en}”</p>
            <p class="ref">{a.ref}</p>
          </li>
        ))}
      </ul>
    </>
  ))}

  <section class="notes">
    <h2>Source</h2>
    <p>The arrangement of this page follows al-Kaffawī (d. 990 AH), <em>Katāʾib Aʿlām al-Akhyār min Fuqahāʾ Madhhab al-Nuʿmān al-Mukhtār</em>.</p>
  </section>
</Base>

<style>
  .sub { font-family: var(--serif); font-size: 1.2rem; color: var(--muted); margin: -4px 0 0; }
  .key { background: var(--card); border: 1px solid var(--gold); border-radius: 12px; padding: 22px; text-align: center; margin: 28px 0 8px; }
  .label { font-size: .8rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; margin: 0 0 6px; }
  .ar { font-family: var(--arabic); direction: rtl; font-size: 1.6rem; line-height: 1.9; margin: 0; }
  .ar.big { font-size: 2.1rem; }
  .en { font-family: var(--serif); font-size: 1.15rem; margin: 4px 0 2px; }
  .ref { font-size: .85rem; color: var(--teal); font-weight: 600; margin: 0; }
  .why { text-align: left; margin: 16px 0 0; padding-top: 14px; border-top: 1px solid var(--sand); }
  h3 { margin-top: 1.6em; color: var(--teal); font-size: 1.15rem; }
  .ayat { list-style: none; padding: 0; margin: 0; }
  .ayat li { text-align: center; padding: 16px 4px; border-bottom: 1px solid var(--sand); }
  .ayat li:first-child { border-top: 1px solid var(--sand); }
  .notes { margin-top: 48px; padding-top: 8px; border-top: 1px solid var(--sand); font-size: .92rem; color: var(--muted); }
  .notes h2 { font-size: 1.15rem; }
</style>
